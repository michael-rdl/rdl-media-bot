# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database (PostGIS in Docker, exposed on localhost)
DB_NAME=media_bot
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Celery / Redis (Redis in Docker, exposed on localhost)
CELERY_BROKER_URL=redis://localhost:6379/0

# rdl-base integration (defaults in settings.py point to fd.racedatalabs.com)
# Only set these if you want to override the defaults:
# RDL_BASE_URL=https://fd.racedatalabs.com
# RDL_BASE_API_URL=https://fd.racedatalabs.com/api/v1
# RDL_INTERNAL_API_KEY=
# RDL_API_USERNAME=
# RDL_API_PASSWORD=
WEBHOOK_SECRET=

# Instagram Graph API
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Instagram Private API (instagrapi fallback)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# YouTube Data API v3
YOUTUBE_CLIENT_SECRETS_FILE=/app/credentials/client_secrets.json
YOUTUBE_OAUTH_TOKEN_FILE=/app/credentials/youtube_token.json

# Media serving for IG Graph API video_url requirement
MEDIA_SERVE_BASE_URL=http://your-public-domain.com/media
