# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database
DB_NAME=media_bot
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0

# rdl-base integration
RDL_BASE_URL=http://nginx:80
RDL_BASE_API_URL=http://nginx:80/api/v1
RDL_INTERNAL_API_KEY=
WEBHOOK_SECRET=

# Instagram Graph API
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Instagram Private API (instagrapi fallback)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# YouTube Data API v3
YOUTUBE_CLIENT_SECRETS_FILE=/app/credentials/client_secrets.json
YOUTUBE_OAUTH_TOKEN_FILE=/app/credentials/youtube_token.json

# Media serving for IG Graph API video_url requirement
MEDIA_SERVE_BASE_URL=http://your-public-domain.com/media
